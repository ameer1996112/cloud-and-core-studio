{
  "name": "cloud-core-studio-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm --workspace @cloud-core/mobile run start",
    "dev:admin": "npm --workspace @cloud-core/admin run dev",
    "lint": "npm --workspaces run lint",
    "typecheck": "npm --workspaces run typecheck",
    "test": "npm --workspaces run test",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
